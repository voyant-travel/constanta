---
import {
  colorSetting,
  linkSetting,
  visibleSetting,
  type SectionInstance,
} from "../../lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const heading = visibleSetting(settings, "heading")
const body = visibleSetting(settings, "body")
const label = visibleSetting(settings, "label")
const href = linkSetting(settings, "page")
const background = colorSetting(settings, "background", "#e7efe9")
---

<section class="callout" style={`--callout-background:${background}`}>
  <div>
    {heading && <h2 set:html={heading} />}
    {body && <div class="callout-body" set:html={body} />}
  </div>
  {label && href && (
    <a href={href}>
      {label}<span aria-hidden="true"> →</span>
    </a>
  )}
</section>

<style>
  .callout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
    margin: clamp(2rem, 5vw, 5rem) max(2rem, calc((100vw - 72rem) / 2));
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: 1rem;
    background: var(--callout-background, #e7efe9);
  }
  h2 {
    max-width: 18ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .callout-body {
    max-width: 44rem;
    margin-top: 1.25rem;
    color: color-mix(in srgb, currentColor 70%, transparent);
  }
  .callout-body :global(p) {
    margin: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0 1.15rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .callout {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
