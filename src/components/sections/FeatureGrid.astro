---
import {
  attributeSetting,
  booleanSetting,
  imageSetting,
  linkSetting,
  numberSetting,
  visibleSetting,
  type SectionInstance,
} from "../../lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const heading = visibleSetting(settings, "heading")
const introduction = visibleSetting(settings, "introduction")
const columns = numberSetting(settings, "columns", 2, 4, 3)
const showDividers = booleanSetting(settings, "show-dividers", true)
const features = section.data.blocks.filter((block) => block.type === "feature")
---

<section class:list={["feature-section", { divided: showDividers }]}>
  <div class="section-heading">
    {heading && <h2 set:html={heading} />}
    {introduction && <p>{introduction}</p>}
  </div>
  <div class="feature-grid" style={`--feature-columns:${columns}`}>
    {
      features.map((feature) => {
        const title = visibleSetting(feature.settings, "title")
        const description = visibleSetting(feature.settings, "description")
        const image = imageSetting(feature.settings, "image")
        const imageAlt = attributeSetting(feature.settings, "image-alt") ?? ""
        const label = visibleSetting(feature.settings, "label")
        const href = linkSetting(feature.settings, "page")
        return (
          <article>
            {image && (
              <img
                src={image}
                alt={imageAlt}
                width="800"
                height="600"
                loading="lazy"
              />
            )}
            {title && <h3>{title}</h3>}
            {description && <p>{description}</p>}
            {label && href && (
              <a href={href}>
                {label}<span aria-hidden="true"> →</span>
              </a>
            )}
          </article>
        )
      })
    }
  </div>
</section>

<style>
  .feature-section {
    padding: clamp(4rem, 9vw, 7rem) max(2rem, calc((100vw - 72rem) / 2));
  }
  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  h2 {
    max-width: 15ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .section-heading p {
    max-width: 38rem;
    margin: 0;
    color: color-mix(in srgb, currentColor 68%, transparent);
    font-size: 1.08rem;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(var(--feature-columns, 3), minmax(0, 1fr));
  }
  article {
    padding: 1.6rem;
  }
  .divided article + article {
    border-left: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: 1.5rem;
    object-fit: cover;
    border-radius: 0.5rem;
  }
  h3 {
    margin: 0 0 0.7rem;
    font-size: 1.2rem;
  }
  article p {
    margin: 0;
    color: color-mix(in srgb, currentColor 68%, transparent);
  }
  article a {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 650;
    text-underline-offset: 0.22em;
  }
  @media (max-width: 760px) {
    .section-heading,
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .divided article + article {
      border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
      border-left: 0;
    }
  }
</style>
